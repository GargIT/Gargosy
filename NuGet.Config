<?xml version="1.0" encoding="utf-8"?>
<!-- video_player_win's build fetches Microsoft's WIL with nuget.exe (#238);
     on a PC whose NuGet has no package source it finds none. nuget.exe reads
     this file from the folders above the build, so it always has nuget.org. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
